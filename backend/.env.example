# ─────────────────────────────────────────────────────────────────
# Azure SQL Database — find these in Azure Portal:
#   SQL databases → your DB → Connection strings → ODBC
# ─────────────────────────────────────────────────────────────────
AZURE_SQL_SERVER=your-server-name.database.windows.net
AZURE_SQL_DATABASE=GymAppDB
AZURE_SQL_USER=your-admin-username
AZURE_SQL_PASSWORD=your-secure-password

# ─────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────
# CORS — comma-separated allowed origins
# In production, restrict this to your app's URL
# ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
