# ─────────────────────────────────────────────────────────────────
# Azure SQL — same values as backend/.env. Read-only use: this script
# only ever SELECTs from these tables.
# ─────────────────────────────────────────────────────────────────
AZURE_SQL_SERVER=your-server-name.database.windows.net
AZURE_SQL_DATABASE=GymAppDB
AZURE_SQL_USER=your-admin-username
AZURE_SQL_PASSWORD=your-secure-password

# ─────────────────────────────────────────────────────────────────
# Supabase — Project Settings -> API
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It is only
# ever used by this one-time script, never by the mobile app. Delete
# or rotate it in the Supabase dashboard once the migration is
# verified.
# ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# UUID of the single Auth user created in the Supabase dashboard.
# All migrated rows are assigned to this user.
TARGET_USER_ID=00000000-0000-0000-0000-000000000000
